# ============================================
# Top Pickleball 50+ — Variáveis de ambiente (exemplo)
# ============================================
# Copie para .env.local e preencha os valores reais
# NUNCA comite .env.local
#
# IMPORTANTE: este projeto é provider-AGNOSTIC.
# NENHUM LLM é definido como padrão. O admin master ou o usuário
# configuram qual provider usar via UI (Admin → LLM Global, ou
# Configurações → Meu LLM Pessoal). As variáveis abaixo são apenas
# conveniências opcionais para ambiente dev.

# Projeto Firebase
FIREBASE_PROJECT_ID=toppkb-dev
FIREBASE_CONFIG={"projectId":"toppkb-dev"}

# --- Firebase Admin SDK (para ingestão local e seed) ---
# Baixe em Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# --- Sentry (opcional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Feature flags ---
FEATURE_AUTH_MAGIC_LINK=true
FEATURE_CHAT_MULTI_AGENTE=true
FEATURE_REGISTRO_TREINO=true
FEATURE_REGISTRO_PARTIDA=true
FEATURE_REGISTRO_ALIMENTACAO=true
FEATURE_REGISTRO_PESO=true
FEATURE_REGISTRO_DOR=true
FEATURE_REGISTRO_SONO=true
FEATURE_METRICAS_AGREGADAS=true
FEATURE_TORNEIOS=true
FEATURE_METAS=true
FEATURE_VECTOR_SEARCH_ESTUDOS=false
FEATURE_LLM_PESSOAL=true
FEATURE_ADMIN_PANEL=true
FEATURE_LGPD_CONSENT=true

# --- Limites ---
RATE_LIMIT_CHAT_POR_MINUTO=20
RATE_LIMIT_REGISTRO_POR_MINUTO=60
RATE_LIMIT_DELETE_ACCOUNT_POR_DIA=1
RETENTION_REGISTROS_DIAS=1825
RETENTION_CONVERSAS_DIAS=365

# --- Domínio ---
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,https://toppkb.web.app
DOMAIN=toppkb.web.app
APP_VERSION=0.1.0
APP_NAME="Top Pickleball 50+"

# --- Email (Resend) — opcional, para futuro ---
RESEND_API_KEY=
RESEND_FROM=no-reply@toppickleball50.app
