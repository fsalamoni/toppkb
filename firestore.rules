rules_version = '2';

// =====================================================================
// Top Pickleball 50+ — Firestore Security Rules
// ISOLAMENTO TOTAL: este app só pode ler/escrever em paths com prefixo
// `toppkb_`. Todas as outras collections (Cofrito, SIGO/CAOCIPP) são
// INVISÍVEIS para este app.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == 'admin' || request.auth.token.admin == 'master');
    }
    function isMaster() { return isSignedIn() && request.auth.token.admin == 'master'; }

    // DEFAULT: bloqueia tudo. Só toppkb_* é acessível.
    match /{document=**} { allow read, write: if false; }

    // USERS — namespace toppkb_users/{uid}
    match /toppkb_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isMaster();

      match /{collection}/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.uid == uid;
        allow update: if isOwner(uid) && request.resource.data.uid == uid;
        allow delete: if isOwner(uid) || isMaster();
      }

      match /chat/conversas/{conversaId} {
        allow read, write: if isOwner(uid) || isAdmin();
        match /mensagens/{msgId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
      }
      match /profile/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
      match /onboarding/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    // AGENTS CONFIG
    match /toppkb_agents_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /toppkb_agents_config/users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // CORPUS
    match /toppkb_corpus/{collection}/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // SEED DATA (read-only)
    match /toppkb_seed/{collection}/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // TOURNAMENTS PUBLIC
    match /toppkb_tournaments_public/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ADMIN
    match /toppkb_admin/{collection}/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /toppkb_admin/admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isMaster();
    }
  }
}
